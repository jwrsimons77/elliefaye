<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set fullTitle = title + " | " + site.name if not isHome else title %}
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
<meta name="theme-color" content="#fdf9f3">
<meta property="og:type" content="{{ ogType or "website" }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
<meta property="og:image" content="{{ site.ogImage | absoluteUrl(site.url) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }} - book reviews and poems from the North West">
<meta property="og:locale" content="en_GB">
{%- if ogType == "article" %}
<meta property="article:published_time" content="{{ page.date | rfc3339 }}">
<meta property="article:author" content="{{ site.author }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.ogImage | absoluteUrl(site.url) }}">
{%- if noindex %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<link rel="icon" href="/images/blue-orangutan.svg" type="image/svg+xml">
<link rel="icon" href="/images/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/images/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preload" href="/fonts/caveat-latin-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/lora-latin-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "{{ site.name }}",
      "description": "Book reviews and poems from a North West poet",
      "publisher": { "@id": "{{ site.url }}/#ellie" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "Blog",
      "@id": "{{ site.url }}/#blog",
      "url": "{{ site.url }}/",
      "name": "{{ site.name }}",
      "description": "Honest book reviews and original poetry written in Manchester, in the North West of England",
      "author": { "@id": "{{ site.url }}/#ellie" },
      "inLanguage": "en-GB"
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#ellie",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}/about/",
      "description": "Poet, book reviewer and writer based in Manchester in the North West of England",
      "homeLocation": { "@type": "Place", "name": "Manchester, North West England" },
      "sameAs": ["{{ site.instagram }}"]
    }
  ]
}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/"><img class="logo-mark" src="/images/blue-orangutan.svg" alt="" width="30" height="44">{{ site.name }}</a>
    <button class="nav-toggle" aria-label="Toggle navigation">Menu</button>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/"{% if page.url == "/" %} class="active" aria-current="page"{% endif %}>Home</a>
      <a href="/book-reviews/"{% if "/book-reviews/" in page.url %} class="active" aria-current="page"{% endif %}>Book Reviews</a>
      <a href="/poems/"{% if "/poems/" in page.url %} class="active" aria-current="page"{% endif %}>Poems</a>
      <a href="/about/"{% if page.url == "/about/" %} class="active" aria-current="page"{% endif %}>About</a>
      <a href="/portfolio/home/">Portfolio</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-cols">
    <div class="footer-col">
      <h4>Site Map</h4>
      <a href="/">Home</a>
      <a href="/book-reviews/">Book Reviews</a>
      <a href="/poems/">Poems</a>
      <a href="/about/">About</a>
      <a href="/portfolio/home/">Portfolio</a>
    </div>
    <div class="footer-col">
      <h4>Follow</h4>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
      <a href="/feed.xml">RSS feed</a>
    </div>
  </div>
  <div class="footer-giant" aria-hidden="true">Tales</div>
</footer>
<script src="/js/main.js"></script>
</body>
</html>
