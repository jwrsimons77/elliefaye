---
layout: layouts/base.njk
ogType: article
---
<section class="tight" style="padding-top:64px">
  <div class="wrap">
    <article class="post">
      <p class="post-meta">
        <span class="post-tag">{{ "Book Review" if type == "review" else "Poem" }}</span>
        &middot; <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      </p>
      <h1>{{ title }}</h1>
      <div class="post-body">
        {%- if type == "review" and book %}
        <aside class="review-scrap" aria-label="Book details">
          {%- if book.author %}<p><span class="scrap-label">author:</span> {{ book.author }}</p>{% endif %}
          {%- if book.genre %}<p><span class="scrap-label">genre:</span> {{ book.genre }}</p>{% endif %}
          {%- if book.pages %}<p><span class="scrap-label">pages:</span> {{ book.pages }}</p>{% endif %}
          {%- if book.read %}<p><span class="scrap-label">read:</span> {{ book.read }}</p>{% endif %}
          {%- if rating %}<p class="stars" aria-label="Rated {{ rating }} out of 5 stars">{{ rating | starString }}</p>{% endif %}
        </aside>
        {%- endif %}
        {{ content | safe }}
      </div>
      <a class="cta" href="{{ "/book-reviews/" if type == "review" else "/poems/" }}">&larr; Back to all {{ "book reviews" if type == "review" else "poems" }}</a>
    </article>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{ page.url | absoluteUrl(site.url) }}#post",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "url": "{{ page.url | absoluteUrl(site.url) }}",
      "datePublished": "{{ page.date | rfc3339 }}",
      "dateModified": "{{ (updated or page.date) | rfc3339 }}",
      "image": "{{ site.ogImage | absoluteUrl(site.url) }}",
      "author": { "@id": "{{ site.url }}/#ellie" },
      "publisher": { "@id": "{{ site.url }}/#ellie" },
      "isPartOf": { "@id": "{{ site.url }}/#blog" },
      "mainEntityOfPage": "{{ page.url | absoluteUrl(site.url) }}",
      "inLanguage": "en-GB"
    }{% if type == "review" and book and rating %},
    {
      "@type": "Review",
      "@id": "{{ page.url | absoluteUrl(site.url) }}#review",
      "url": "{{ page.url | absoluteUrl(site.url) }}",
      "name": {{ title | dump | safe }},
      "author": { "@id": "{{ site.url }}/#ellie" },
      "datePublished": "{{ page.date | rfc3339 }}",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ rating }}",
        "bestRating": "5",
        "worstRating": "1"
      },
      "itemReviewed": {
        "@type": "Book",
        "name": {{ (book.title or title) | dump | safe }},
        "author": { "@type": "Person", "name": {{ book.author | dump | safe }} }{% if book.isbn %},
        "isbn": "{{ book.isbn }}"{% endif %}{% if book.pages %},
        "numberOfPages": {{ book.pages }}{% endif %}
      }
    }{% endif %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "{{ "Book Reviews" if type == "review" else "Poems" }}", "item": "{{ site.url }}{{ "/book-reviews/" if type == "review" else "/poems/" }}" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }} }
      ]
    }
  ]
}
</script>
